{
  "name": "@ratel-works/dsh-lumina",
  "version": "0.1.0",
  "description": "Ratel Lumina — motion enhancement layer for the DeepSeek Harness client: brand mark, composer edge glow, streaming caret, button press, new-session hero, and session activity.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "assets/readme/hero-zh-CN.webp"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "immediately": false
    },
    "catalog": {
      "category": "ui",
      "summary": {
        "en": "Ratel Lumina — a light, breathing motion layer for the DeepSeek Harness client: brand, composer halo, caret, press feedback, hero entrance, and session activity.",
        "zh": "Ratel Lumina —— 为 DeepSeek Harness 客户端添加一层轻盈会呼吸的动效：品牌、输入框光晕、光标、按压反馈、首屏入场与会话进行中指示。"
      },
      "capabilities": [
        "slots",
        "locale",
        "settings"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf lib/types && tsc -p tsconfig.build.json && tsdown",
    "build:client": "tsdown",
    "install:local": "bash tools/install-local.sh",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:hooks": "node tools/verify-hooks.mjs",
    "watch": "tsdown --watch",
    "gen:brand": "node tools/gen-brand-assets.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@types/node": "22.20.4",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "motion",
    "ui",
    "lumina",
    "ratel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/golddream-y/ratel-dsh-lumina.git"
  },
  "homepage": "https://github.com/golddream-y/ratel-dsh-lumina#readme",
  "bugs": {
    "url": "https://github.com/golddream-y/ratel-dsh-lumina/issues"
  },
  "author": "golddream-y",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
